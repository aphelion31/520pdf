PORT=8080
# Local-only by default. Container overrides this to 0.0.0.0:8080.
BIND_ADDR=127.0.0.1:8080
WEB_DIR=web/build/client

# Optional workbench sign-in (open-access when AUTH_USER is empty).
# Generate Argon2id PHC hash with: pdf520 hash-password 'your-password'
AUTH_USER=
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# Optional OpenAI-compatible provider. No request is sent without per-job consent.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Only for legacy `pdf520 webhook`, not the web UI.
WEBHOOK_SECRET=
DOCS_USER=
DOCS_PASSWORD_HASH=

# Comma-separated allowed CORS origins for /api/* (default: * for all origins)
CORS_ORIGINS=*
