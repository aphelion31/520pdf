PORT=8080
# Local-only by default. Container overrides this to 0.0.0.0:8080.
BIND_ADDR=127.0.0.1:8080

# Optional OpenAI-compatible provider. No request is sent without per-job consent.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Only for legacy `pdf520 webhook`, not the web UI.
WEBHOOK_SECRET=
DOCS_USER=
DOCS_PASSWORD=
